<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.lifeos.commitmentsweep.plist.template — Source template. Install via:
    bun ~/.claude/LIFEOS/TOOLS/InstallCommitmentSweep.ts

  The installer resolves the running bun binary and $HOME at install time,
  substitutes {{BUN}} / {{BUN_DIR}} / {{HOME}}, writes the materialized plist to
  ~/Library/LaunchAgents/, and bootstraps it with launchctl. This template stays
  clean of principal-specific paths so it ships in the public LifeOS release.

  {{BUN}} rather than a hardcoded /opt/homebrew/bin/bun: that path is an Apple
  Silicon Homebrew assumption, so the job silently never ran on Intel macs
  (/usr/local), on ~/.bun installs, and on any non-Homebrew bun. Matches the
  other 16 templates (public issues #1875, @GRyndStone; #1880, @schmetti-dev).

  Behavior:
    Runs CommitmentSweep.ts daily at 7am local (StartCalendarInterval Hour=7).
    Crash-loop rate-limited (ThrottleInterval 60s).
    stdout/stderr captured to MEMORY/STATE/com.lifeos.commitmentsweep.log.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifeos.commitmentsweep</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{HOME}}/.claude/LIFEOS/TOOLS/CommitmentSweep.ts</string>
  </array>

  <!-- RunAtLoad true so a missed nightly fires at next login — a laptop asleep
       through the scheduled time otherwise never runs it (public issue #1513, @xmasyx). -->
  <key>RunAtLoad</key>
  <true/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>{{HOME}}/.claude/LIFEOS/MEMORY/STATE/com.lifeos.commitmentsweep.log</string>

  <key>StandardErrorPath</key>
  <string>{{HOME}}/.claude/LIFEOS/MEMORY/STATE/com.lifeos.commitmentsweep.log</string>

  <key>WorkingDirectory</key>
  <string>{{HOME}}/.claude</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{BUN_DIR}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
  </dict>
</dict>
</plist>
