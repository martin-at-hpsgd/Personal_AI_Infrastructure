# Interceptor per-machine preferences.
#
# Sourced as plain shell (`. preferences.env`) by every Interceptor tool that
# drives the browser: Tools/PreflightIsolation.sh, Tools/Capture.sh,
# Tools/CleanupTabs.sh, Tools/EnsureTestProfile.sh, Tools/LaunchTestProfile.sh.
# Keep every line as KEY="value", a # comment, or blank.
#
# Edit the two REQUIRED values below; every Interceptor tool refuses (exit 8)
# until then. preferences.env.example next to this file is a reference copy.

# REQUIRED. The pinned test context the agent is allowed to drive. Set this
# friendly name once in the extension popup (Interceptor toolbar icon ->
# Context ID -> Save). Friendly names survive extension reloads; raw UUIDs rot
# on every reload. Empty = every tool refuses to run (exit 8). Never "Default".
INTERCEPTOR_TEST_CONTEXT_ID="interceptor-test"

# REQUIRED for auto-launch. The dedicated test profile's on-disk directory name
# (e.g. "Profile 2"). Map directory -> profile name via Chrome's "Local State"
# file (profile.info_cache) or chrome://version -> Profile Path. Deliberately no
# default: guessing a profile could open your working window. Empty =
# LaunchTestProfile.sh refuses (exit 2) and EnsureTestProfile.sh will not launch.
INTERCEPTOR_TEST_CHROME_PROFILE=""

# Optional. Browser app name. Default "Google Chrome".
INTERCEPTOR_TEST_BROWSER="Google Chrome"

# Optional. Display name of the test profile as Chrome prints it at the END of every
# window title ("<page> - Google Chrome - <name>"; see chrome://settings/manageProfile).
# EnsureTestProfile.sh reads it to refuse launching a second window when one of this
# profile is already open. Empty = the window probe is skipped and only the machine-wide
# launch lock (one launch per 90s) throttles auto-launches.
INTERCEPTOR_TEST_CHROME_PROFILE_NAME=""

# Optional. Home bounds of the test-profile window as "left,top,width,height" in
# chrome.windows screen coordinates (primary display top-left = 0,0; screens to the left
# are negative x). Every READY from EnsureTestProfile.sh runs Tools/PinTestWindow.sh, which
# moves any drifted window of the pinned context back here, so the test browser always
# sits where you expect it. Read the value from
# `interceptor window list --context "$INTERCEPTOR_TEST_CONTEXT_ID"` once the window is
# where you want it (top is Chrome's menu-bar clamp, e.g. 30). Empty = never moved.
INTERCEPTOR_TEST_WINDOW_BOUNDS=""

# Optional. Direct path to the browser binary, used so launches work while the
# browser is already running (macOS `open -a ... --args` drops the args).
# Empty = /Applications/<INTERCEPTOR_TEST_BROWSER>.app/Contents/MacOS/<INTERCEPTOR_TEST_BROWSER>
INTERCEPTOR_TEST_BROWSER_BIN=""

# Optional. Comma-separated context IDs (or friendly names) of your WORKING
# profiles. The preflight gate, Capture.sh and CleanupTabs.sh hard-deny driving
# any of these. "Default" is always denied whether or not it is listed here.
# Example: "work-profile,personal-profile"
INTERCEPTOR_WORKING_PROFILE_IDS=""

# Optional. Blank-frame guard threshold for Capture.sh: a capture whose pixel
# standard deviation is below this is rejected as blank (exit 12). Default 0.017.
INTERCEPTOR_MIN_STDDEV="0.017"

# Optional. Directory holding the unpacked extension (manifest.json inside).
# Empty = PreflightIsolation.sh checks the skill's Extension/ pin, then
# /Library/Application Support/Interceptor/extension.
INTERCEPTOR_EXT_DIR=""

# Optional. Source checkout of the interceptor repo, used by the preflight's
# extension-freshness check (compares against <src>/extension/dist).
# Empty = $HOME/Projects/interceptor, or the origin recorded in PINNED_FROM.txt.
INTERCEPTOR_SRC=""

# Not read from this file (environment only; set them in your shell if needed):
#   INTERCEPTOR_VERIFY_CDP_PORT, INTERCEPTOR_VERIFY_USER_DATA_DIR,
#   INTERCEPTOR_VERIFY_HEADFUL, INTERCEPTOR_VERIFY_WINDOW, INTERCEPTOR_CHROME_BIN
#   (Tools/VerifyViewport.ts), INTERCEPTOR_MIN_STDDEV in Tools/VerifyImageProbe.ts,
#   and INTERCEPTOR_SRC in Tools/Pin.sh. Those scripts never source this file.
