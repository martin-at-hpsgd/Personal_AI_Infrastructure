<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.lifeos.coach.plist.template — Source template. Install via:
    bun ~/.claude/LIFEOS/TOOLS/InstallCoach.ts

  The installer reads $HOME at install time, substitutes {{HOME}}/{{BUN}}/{{BUN_DIR}},
  writes the materialized plist to ~/Library/LaunchAgents/, and bootstraps it with
  launchctl. This template stays clean of principal-specific paths so it ships in
  the public LifeOS release.

  Behavior:
    Runs the CoachLoop miner once daily at 06:30 PT (StartCalendarInterval) —
    before the principal's day, after the overnight deriver.
    HEADLESS: LIFEOS_NOTIFICATION_CHANNEL=headless is set so the run is
    structurally silent; it makes zero VoiceServer calls and surfaces only via
    the Pulse /upgrades queue (Coach source filter) (CL-6). The standalone /coach
    route was retired and folded into /upgrades.
    NOT RunAtLoad — a daily coaching pass should not fire on every boot/relogin.
    Crash-loop rate-limited (ThrottleInterval 60s).
    stdout/stderr captured to MEMORY/STATE/com.lifeos.coach.log.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifeos.coach</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{HOME}}/.claude/LIFEOS/TOOLS/CoachReview.ts</string>
    <string>run</string>
    <string>--headless</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>{{HOME}}/.claude/LIFEOS/MEMORY/STATE/com.lifeos.coach.log</string>

  <key>StandardErrorPath</key>
  <string>{{HOME}}/.claude/LIFEOS/MEMORY/STATE/com.lifeos.coach.log</string>

  <key>WorkingDirectory</key>
  <string>{{HOME}}/.claude</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{BUN_DIR}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>LIFEOS_NOTIFICATION_CHANNEL</key>
    <string>headless</string>
  </dict>
</dict>
</plist>
