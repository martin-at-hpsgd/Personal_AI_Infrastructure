    "install-app": "bun test && bun build.ts --install"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.3.0"
  },
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
