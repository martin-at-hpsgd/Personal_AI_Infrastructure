{
  "name": "pulse-desktop",
  "productName": "Pulse Desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun build.ts",
    "start": "bun run build && electron .",
