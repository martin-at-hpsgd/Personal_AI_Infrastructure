<?xml version="1.0" encoding="UTF-8"?>
<!-- Vigil five-minute launchd service template; InstallVigil.ts fills every placeholder. @version 0.3.0 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lifeos.vigil</string>
  <key>ProgramArguments</key><array><string>{{BUN}}</string><string>{{TICK}}</string></array>
  <key>EnvironmentVariables</key><dict><key>LIFEOS_NOTIFICATION_CHANNEL</key><string>headless</string><key>HOME</key><string>{{HOME}}</string><key>PATH</key><string>{{PATH}}</string>{{EXTRA_ENV}}</dict>
  <key>StartInterval</key><integer>300</integer>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>{{HOME}}/.local/state/lifeos/vigil/service.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/.local/state/lifeos/vigil/service.log</string>
</dict></plist>
