<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.lifeos.job.plist.template — one launchd job per entry in LIFEOS/USER/CONFIG/agent-jobs.json.
  Materialized by: bun ~/.claude/LIFEOS/TOOLS/InstallAgentJobs.ts
  Runner:          bun ~/.claude/LIFEOS/TOOLS/AgentJob.ts {{JOB_ID}}

  Job: {{TITLE}}
  Headless channel (LIFEOS_NOTIFICATION_CHANNEL=headless) — scheduled jobs never voice-notify.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{LIFEOS_ROOT}}/LIFEOS/TOOLS/AgentJob.ts</string>
    <string>{{JOB_ID}}</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{LIFEOS_ROOT}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>PATH</key>
    <string>{{BUN_DIR}}:{{HOME}}/.local/bin:{{HOME}}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LIFEOS_ROOT</key>
    <string>{{LIFEOS_ROOT}}</string>
    <key>LIFEOS_NOTIFICATION_CHANNEL</key>
    <string>headless</string>
  </dict>

  {{SCHEDULE}}

  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
