<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lifeos.pulse-menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Library/Application Support/LifeOS/Helpers.noindex/LifeOS Pulse.app/Contents/MacOS/LifeOS Pulse</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Crash recovery only. An unconditional KeepAlive cannot tell a crash from
         the "Quit Menu Bar" item, which terminates with status 0, so launchd
         relaunched the app within seconds and the icon could not be removed at
         all. (public issue #1909, @xmasyx) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LIFEOS_PULSE_DIR</key>
        <string>__HOME__/.claude/LIFEOS/PULSE</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.claude/LIFEOS/PULSE/logs/menubar-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/LIFEOS/PULSE/logs/menubar-stderr.log</string>
</dict>
</plist>
